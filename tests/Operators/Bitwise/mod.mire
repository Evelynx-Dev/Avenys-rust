// Bitwise operators: shift, AND, OR, XOR on integer values

@[test]
pub fn shift_left_by_three: () :bool {
    set value = 1
    set shifted = value << 3

    // Tests left shift by 3 positions: 1 << 3 = 8
    return shifted == 8
}

@[test]
pub fn bitwise_and_operation: () :bool {
    set a = 15
    set b = 8
    set and_result = a & b

    // Tests bitwise AND: 15 & 8 = 8
    return and_result == 8
}

@[test]
pub fn bitwise_or_operation: () :bool {
    set a = 3
    set b = 5
    set or_result = a | b

    // Tests bitwise OR: 3 | 5 = 7
    return or_result == 7
}

@[test]
pub fn bitwise_xor_operation: () :bool {
    set a = 6
    set b = 3
    set xor_result = a ^ b

    // Tests bitwise XOR: 6 ^ 3 = 5
    return xor_result == 5
}
