// Logical operators are tested with all short-circuit truth combinations.

@[test]
pub fn and_true_true: () :bool { return true && true }

@[test]
pub fn and_false_true: () :bool { return !(false && true) }

@[test]
pub fn and_true_false: () :bool { return !(true && false) }

@[test]
pub fn or_true_false: () :bool { return true || false }

@[test]
pub fn or_false_true: () :bool { return false || true }

@[test]
pub fn or_false_false: () :bool { return !(false || false) }

@[test]
pub fn combined_logic: () :bool { return (3 > 2) && (2 < 3) }

@[test]
pub fn negated_comparison: () :bool { return !(3 < 2) }
