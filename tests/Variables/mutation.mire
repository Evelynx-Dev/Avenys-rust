// Mutation tests exercise the language's explicit mutable binding syntax.

@[test]
pub fn increment_mutable: () :bool {
    set value = 1 mut
    set value = value + 1
    return value == 2
}

@[test]
pub fn decrement_mutable: () :bool {
    set value = 4 mut
    set value = value - 1
    return value == 3
}

@[test]
pub fn multiply_mutable: () :bool {
    set value = 3 mut
    set value = value * 2
    return value == 6
}

@[test]
pub fn divide_mutable: () :bool {
    set value = 8 mut
    set value = value / 2
    return value == 4
}

@[test]
pub fn boolean_reassignment: () :bool {
    set value = false mut
    set value = true
    return value
}

@[test]
pub fn string_reassignment: () :bool {
    set value = "old" mut
    set value = "new"
    return value == "new"
}

@[test]
pub fn chained_reassignment: () :bool {
    set value = 0 mut
    set value = value + 1
    set value = value + 1
    return value == 2
}

@[test]
pub fn mutation_in_branch: () :bool {
    set value = 0 mut
    if true { set value = 9 }
    return value == 9
}
