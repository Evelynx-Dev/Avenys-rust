// Struct construction and field access are tested outside the integrated POO run.

struct Coordinate { x :i64 y :i64 }

fn coordinate_sum: (point :Coordinate) :i64 { return point.x + point.y }

@[test]
pub fn coordinate_origin: () :bool {
    set point = Coordinate(0 0)
    return coordinate_sum(point) == 0
}

@[test]
pub fn coordinate_positive: () :bool {
    set point = Coordinate(3 4)
    return coordinate_sum(point) == 7
}

@[test]
pub fn coordinate_negative: () :bool {
    set point = Coordinate(-3 -4)
    return coordinate_sum(point) == -7
}

@[test]
pub fn coordinate_x_field: () :bool { set point = Coordinate(8 1)
    return point.x == 8 }

@[test]
pub fn coordinate_y_field: () :bool { set point = Coordinate(8 1)
    return point.y == 1 }

@[test]
pub fn coordinate_rebuild: () :bool {
    set point = Coordinate(2 5)
    set rebuilt = Coordinate(point.x point.y)
    return rebuilt.y == 5
}

@[test]
pub fn coordinate_difference: () :bool {
    set point = Coordinate(9 4)
    return point.x - point.y == 5
}

@[test]
pub fn coordinate_combined: () :bool {
    set first = Coordinate(1 2)
    set second = Coordinate(3 4)
    return coordinate_sum(first) + coordinate_sum(second) == 10
}
