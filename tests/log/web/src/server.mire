// Mire-only dashboard backend and frontend. This source lives below the
// public log root but exposes only fixed routes and generated JSON; it never
// maps a client path to the host filesystem. Historical run records are kept
// in the SQLite file beside this source, while JSON logs remain replaceable.
load kioto::net
load kioto::fs
load kioto::async
load kioto::strings
load kioto::time
load sqlite

// Pin the server to the test fixture copy, so Kioto/Mire library changes can
// be rebuilt independently without silently changing this integration target.
extern lib "sqlite3" "../../../tests/libs/sqlite/libsqlite3.so"
extern lib "kioto" "../../../tests/libs/kioto/kioto.so"
extern lib "mire" "../../../tests/libs/mire/mire.so"
extern fn rt_websocket_accept: (client_key :&str) :str lib "c"
extern fn rt_websocket_text_frame: (payload :&str) :str lib "c"
extern fn rt_web_log_append: (path :&str, line :&str) :i64 lib "c"

fn join: (left :&str, right :&str) :str { return strings::concat(left right) }

fn json_number: (document :&str, name :&str) :i64 {
    set marker = strings::concat("\"" strings::concat(name "\":"))
    set start = strings::index(document marker)
    if start < 0 { return 0 }
    set value_start = start + strings::len(marker)
    set remaining = strings::substr(document value_start strings::len(document) - value_start)
    set end = strings::index(remaining ",") mut
    if end < 0 { set end = strings::index(remaining "}") }
    if end < 0 { return 0 }
    return strings::to::i64(strings::trim(strings::substr(remaining 0 end)))
}

fn record_current_run: () :str {
    set snapshot = fs::read("../global/count.json")
    set timestamp = strings::from::i64(time::now::ms())
    sqlite::record_run("src/runs.sqlite3" "global" json_number(snapshot "Ok") json_number(snapshot "Err") json_number(snapshot "ram_mb") json_number(snapshot "time_ms") timestamp)
    return sqlite::latest("src/runs.sqlite3")
}

fn http_response: (status :&str, content_type :&str, body :&str) :str {
    set header = "HTTP/1.1 " mut
    set header = join(header status)
    set header = join(header "\r\nContent-Type: ")
    set header = join(header content_type)
    set header = join(header "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
    return join(header body)
}

// Appends one bounded event to the private web log. Request paths are never
// used as filenames, so the browser cannot turn this into file disclosure.
fn log_event: (kind :&str, detail :&str) {
    fs::mkdir("logs")
    set line = strings::from::i64(time::now::ms()) mut
    set line = join(line " ")
    set line = join(line kind)
    set line = join(line " ")
    set line = join(line detail)
    rt_web_log_append("logs/connections.log" line)
}

fn logs_json: (latest :&str) :str {
    set body = "{\"count\":" mut
    set body = join(body fs::read("../global/count.json"))
    set body = join(body ",\"latest_recorded_at\":\"")
    set body = join(body latest)
    return join(body "\"}")
}

fn header_value: (request :&str, name :&str) :str {
    set marker = join(name ":")
    set start = strings::index(request marker)
    if start < 0 { return "127.0.0.1" }
    set value_start = start + strings::len(marker)
    set remaining = strings::substr(request value_start strings::len(request) - value_start)
    set end = strings::index(remaining "\r\n")
    if end < 0 { return strings::trim(remaining) }
    return strings::trim(strings::substr(remaining 0 end))
}

fn request_body: (request :&str) :str {
    set marker = "\r\n\r\n"
    set start = strings::index(request marker)
    if start < 0 { return "" }
    set value_start = start + strings::len(marker)
    return strings::substr(request value_start strings::len(request) - value_start)
}

fn html_page: () :str {
    return fs::read("src/web.html")
}

fn websocket_key: (request :&str) :str {
    set marker = "Sec-WebSocket-Key:"
    set start = strings::index(request marker)
    if start < 0 { return "" }
    set value_start = start + strings::len(marker)
    set remaining = strings::substr(request value_start strings::len(request) - value_start)
    set end = strings::index(remaining "\r\n")
    if end < 0 { return strings::trim(remaining) }
    return strings::trim(strings::substr(remaining 0 end))
}

fn serve_socket: (socket :Socket, events :&Channel, latest :&str) :bool {
    set buffer = strings::repeat("\0" 16384) :str mut
    set received = net::socket::recv(socket buffer 16384)
    if received <= 0 {
        net::socket::close(socket)
        return true
    }
    set request = strings::substr(buffer 0 received)
    set sent = async::channel::send(events "log-client")
    if sent < 0 {
        net::socket::close(socket)
        return true
    }
    if strings::contains(request "Upgrade: websocket") {
        set accept = rt_websocket_accept(websocket_key(request))
        set response = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " mut
        set response = join(response accept)
        set response = join(response "\r\n\r\n")
        net::socket::send(socket response)
        set frame = rt_websocket_text_frame(latest)
        net::socket::send(socket frame)
        log_event("WEBSOCKET" header_value(request "X-Forwarded-For"))
        net::socket::close(socket)
        return true
    }
    set status = "200 OK" mut
    set body = "{}" mut
    set content_type = "application/json; charset=utf-8" mut
    if strings::contains(request "GET / ") {
        set body = html_page()
        set content_type = "text/html; charset=utf-8"
    } else {
        if strings::contains(request "GET /api/logs ") {
            set body = logs_json(latest)
        } else {
            if strings::contains(request "GET /api/status ") {
                set body = "{\"status\":\"ok\",\"logs\":\"global\"}"
            } else {
                if strings::contains(request "POST /__console ") {
                    set command = strings::trim(request_body(request))
                    log_event("CONSOLE" join(header_value(request "X-Console-IP") join(" " command)))
                    if command == "STOP" {
                        set response = http_response("200 OK" content_type "stopping")
                        net::socket::send(socket response)
                        net::socket::close(socket)
                        return false
                    }
                    if strings::starts::with(command "CHAT ") {
                        set name = strings::trim(strings::substr(command 5 strings::len(command) - 5))
                        set chat_line = join(header_value(request "X-Console-IP") "@")
                        log_event("CHAT" join(chat_line name))
                        set body = join("{\"chat\":\"" join(chat_line name))
                        set body = join(body "\"}")
                    } else {
                        if strings::starts::with(command "GET /api/status") {
                            set body = "{\"status\":\"ok\"}"
                        } else {
                            if strings::starts::with(command "GET /api/logs") {
                                set body = logs_json(latest)
                            } else {
                                set status = "403 Forbidden"
                                set body = "{\"error\":\"route rejected\"}"
                            }
                        }
                    }
                } else {
                    set status = "404 Not Found"
                    set body = "{\"error\":\"not found\"}"
                }
            }
        }
    }
    set response = http_response(status content_type body)
    log_event("HTTP" header_value(request "X-Forwarded-For"))
    net::socket::send(socket response)
    net::socket::close(socket)
    return true
}

pub fn main: () {
    use dasu("Avenys log server listening on http://127.0.0.1:18080/")
    use dasu("API: GET /api/status, GET /api/logs, WebSocket /ws")
    use dasu("Console: owl run -j 6 src/console.mire --release -O 3")
    set latest = record_current_run()
    set listener = net::listener::bind(18080 :u16)
    if listener.handle <= 0 {
        use dasu("Unable to bind port 18080")
        return
    }
    set events = async::channel::create()
    while true {
        set socket = net::listener::accept(listener)
        if socket.handle <= 0 {
            return
        }
        set running = serve_socket(socket events latest)
        if !running { return }
    }
}
